# Leave blank for local-only browser storage. These client values are public,
# not server credentials. Never put a service-account key in a VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development only; the demo project cannot access production resources.
VITE_USE_FIREBASE_EMULATORS=false
